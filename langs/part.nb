(program
  (func nab_part (op a b)
    (var r 0)
    (if (== op 0) (set! r (+ a b))
      (if (== op 1) (set! r (- a b))
        (if (== op 2) (set! r (* a b))
          (if (== op 3) (set! r (/ a b))
            (if (== op 11) (set! r (bin2dec a))
              (if (== op 12) (set! r (dec2bin a))
                (set! r 0)))))))
    (return r))

  (func bin2dec (n)
    (var r 0)
    (var p 1)
    (var x n)
    (while (> x 0)
      (set! r (+ r (* (% x 10) p)))
      (set! p (* p 2))
      (set! x (/ x 10)))
    (return r))

  (func dec2bin (n)
    (var r 0)
    (var p 1)
    (var x n)
    (while (> x 0)
      (set! r (+ r (* (% x 2) p)))
      (set! p (* p 10))
      (set! x (/ x 2)))
    (return r)))
